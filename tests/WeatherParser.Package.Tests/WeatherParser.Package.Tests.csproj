<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestAdapter" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeCoverage" PrivateAssets="all" />
    <PackageReference Include="FluentAssertions" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WeatherParser.Parsing" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgWeatherParser_Parsing)/schemas/export/v1/weatherparser-export-v1.xsd" Link="Schemas/weatherparser-export-v1.xsd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../schemas/export/v1/weatherparser-export-v1.xsd" Link="ReferenceSchemas/weatherparser-export-v1.xsd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The restored WeatherParser.Parsing package folder, for the package metadata and contents tests (P9.05). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WeatherParserPackageRoot</_Parameter1>
      <_Parameter2>$(PkgWeatherParser_Parsing)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
