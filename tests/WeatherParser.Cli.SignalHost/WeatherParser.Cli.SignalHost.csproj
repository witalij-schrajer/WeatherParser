    <Compile Include="../../examples/WeatherParser.Cli/Lifetime/ProcessTerminator.cs" Link="Lifetime/ProcessTerminator.cs" />
    <Compile Include="../../examples/WeatherParser.Cli/Diagnostics/CliErrorIds.cs" Link="Diagnostics/CliErrorIds.cs" />
