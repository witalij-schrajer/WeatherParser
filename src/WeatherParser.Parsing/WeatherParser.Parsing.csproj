<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>WeatherParser.Parsing</PackageId>
    <Version>0.1.0-initial</Version>
    <Authors>WeatherParser contributors</Authors>
    <Description>Work-in-progress weather parsing library. Parser implementations are not available yet.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../schemas/export/v1/weatherparser-export-v1.xsd" Pack="true" PackagePath="schemas/export/v1/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test seam for bounds that cannot be exercised at full size in unit tests (P4.08: the 2 GiB MOSMIX_S member bound). -->
    <InternalsVisibleTo Include="WeatherParser.Parsing.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
