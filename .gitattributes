# Generated schemas are compared byte for byte (contract C-98); keep LF on every checkout.
schemas/**/*.xsd text eol=lf
# Text files packed into the NuGet package are LF on every checkout, so packages built on Windows and Linux carry the same bytes (P9 release contract RL-03 A).
README.md text eol=lf
LICENSE text eol=lf
# Shell scripts run by bash in Git Bash too, so they stay LF on every checkout.
scripts/check-ci-changes-job.sh text eol=lf
